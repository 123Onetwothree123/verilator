import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from typing import Any, NoReturn, Optional


def fatal(message: str) -> NoReturn:
    sys.stderr.write("%Error: " + message + "\n")
    sys.exit(1)


def parse_flags(flags: str) -> list[str]:
    return [flag for flag in shlex.split(flags) if flag not in ('-MMD', '-MP')]


def is_module_control_flag(flag: str) -> bool:
    return (flag == '-fmodule-only' or flag == '-fmodule-header'
            or flag.startswith('-fmodule-header='))


def normalize_args(argv: list[str]) -> list[str]:
    result = []
    index = 0
    while index < len(argv):
        if argv[index] in ('--cxxflags', '--cppflags') and index + 1 < len(argv):
            result.append(argv[index] + '=' + argv[index + 1])
            index += 2
        else:
            result.append(argv[index])
            index += 1
    return result


def external_modules(flags: list[str]) -> set[str]:
    prefix = '-fmodule-file='
    modules = set()
    for flag in flags:
        if flag.startswith(prefix):
            modules.add(flag[len(prefix):].split('=', 1)[0])
    return modules


def collect_sources(args: argparse.Namespace) -> list[dict[str, Any]]:
    modules: list[dict[str, Any]] = []
    objects: dict[str, str] = {}
    for source in args.source:
        abs_source = os.path.abspath(source)
        stem = os.path.splitext(os.path.basename(abs_source))[0]
        obj = stem + '.o'
        if obj in objects:
            fatal("Multiple C++ sources produce '" + obj + "': '" + objects[obj] + "' and '"
                  + abs_source + "'")
        objects[obj] = abs_source
        modules.append({
            'source': abs_source,
            'stem': stem,
            'obj': obj,
            'provides': [],
            'requires': [],
        })
    return modules


HEADER_IMPORT_RE = re.compile(r'^\s*(?:export\s+)?import\s+"([^"]+)"\s*;', re.MULTILINE)


def header_imports(path: str) -> list[str]:
    with open(path, 'r', encoding='utf8', errors='replace') as fh:
        text = fh.read()
    text = re.sub(r'/\*.*?\*/', '', text, flags=re.DOTALL)
    text = re.sub(r'//[^\n]*', '', text)
    return HEADER_IMPORT_RE.findall(text)


def include_directories(flags: list[str]) -> list[str]:
    dirs: list[str] = []
    index = 0
    while index < len(flags):
        flag = flags[index]
        if flag in ('-I', '-iquote') and index + 1 < len(flags):
            dirs.append(flags[index + 1])
            index += 1
        elif flag.startswith('-I') and len(flag) > 2:
            dirs.append(flag[2:])
        elif flag.startswith('-iquote') and len(flag) > 7:
            dirs.append(flag[7:])
        index += 1
    return dirs


def resolve_header(name: str, importer: str, include_dirs: list[str]) -> Optional[str]:
    if os.path.isabs(name):
        return name if os.path.isfile(name) else None
    candidate = os.path.join(os.path.dirname(importer), name)
    if os.path.isfile(candidate):
        return candidate
    for directory in include_dirs:
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate):
            return candidate
    return None


def gcc_header_cmi(path: str) -> str:
    parts = [part for part in os.path.normpath(path).split(os.sep) if part]
    if not os.path.isabs(path):
        parts.insert(0, '.')
    encoded = [',' if part == '.' else ',,' if part == '..' else part for part in parts]
    return os.path.join('gcm.cache', *encoded) + '.gcm'


def compile_header(args: argparse.Namespace, cppflags: list[str], cxxflags: list[str],
                   header: dict[str, Any]) -> None:
    command = ([args.cxx] + cppflags + cxxflags
               + ['-fmodule-header', '-x', 'c++-header', header['path']])
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0:
        sys.stderr.write(result.stdout)
        sys.stderr.write(result.stderr)
        fatal("C++ header unit build failed for '" + header['path'] + "'")
    if not os.path.exists(header['cmi']):
        fatal("C++ header unit build produced no CMI at '" + header['cmi'] + "'")


def prepare_gcc_headers(args: argparse.Namespace, cppflags: list[str], cxxflags: list[str],
                        modules: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    include_dirs = include_directories(cppflags + cxxflags)
    headers: dict[str, dict[str, Any]] = {}

    def add(path: str) -> dict[str, Any]:
        key = os.path.abspath(path)
        if key in headers:
            return headers[key]
        entry: dict[str, Any] = {'path': path, 'cmi': gcc_header_cmi(path), 'deps': []}
        headers[key] = entry
        for name in header_imports(path):
            dep = resolve_header(name, path, include_dirs)
            if dep is None:
                fatal("Can not find C++ header unit '" + name + "' imported by '" + path + "'")
            entry['deps'].append(add(dep))
        return entry

    for module in modules:
        module['headers'] = []
        for name in header_imports(module['source']):
            dep = resolve_header(name, module['source'], include_dirs)
            if dep is None:
                fatal("Can not find C++ header unit '" + name + "' imported by '"
                      + module['source'] + "'")
            module['headers'].append(add(dep))

    built: set[str] = set()

    def build(entry: dict[str, Any]) -> None:
        if entry['path'] in built:
            return
        built.add(entry['path'])
        for dep in entry['deps']:
            build(dep)
        if not os.path.exists(entry['cmi']):
            compile_header(args, cppflags, cxxflags, entry)

    for entry in headers.values():
        build(entry)
    return headers


def scan_gcc(args: argparse.Namespace, cppflags: list[str], cxxflags: list[str],
             modules: list[dict[str, Any]]) -> None:
    for module in modules:
        deps_file = os.path.join(args.objdir, module['stem'] + '.deps.json')
        command = ([args.cxx] + cppflags + cxxflags + [
            '-MM',
            '-fdeps-format=p1689r5',
            '-fdeps-file=' + deps_file,
            '-fdeps-target=' + module['obj'],
            '-fsyntax-only',
            module['source'],
        ])
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if result.returncode != 0:
            sys.stderr.write(result.stdout)
            sys.stderr.write(result.stderr)
            fatal("C++ module scan failed for '" + module['source'] + "'")
        if not os.path.exists(deps_file):
            fatal("C++ module scan produced no dependency file for '" + module['source'] + "'")

        with open(deps_file, 'r', encoding='utf8') as fh:
            data = json.load(fh)
        rules = data.get('rules', [])
        rule = next((entry for entry in rules
                     if entry.get('primary-output') == module['obj']), None)
        if rule is None and rules:
            rule = rules[0]
        if rule is None:
            rule = {}

        module['provides'] = [provide['logical-name']
                              for provide in rule.get('provides', [])
                              if provide.get('is-interface', False)]
        module['requires'] = [require['logical-name']
                              for require in rule.get('requires', [])]


def find_clang_scan_deps(cxx: str) -> str:
    scan_deps = shutil.which('clang-scan-deps')
    if not scan_deps:
        result = subprocess.run([cxx, '--version'], stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
        match = re.search(r'clang version (\d+)', result.stdout)
        if match:
            scan_deps = shutil.which('clang-scan-deps-' + match.group(1))
    if not scan_deps:
        fatal("Could not find clang-scan-deps; install the Clang tools matching '" + cxx + "'")
    return scan_deps


def scan_clang(args: argparse.Namespace, cppflags: list[str], cxxflags: list[str],
               modules: list[dict[str, Any]]) -> None:
    scan_deps = find_clang_scan_deps(args.cxx)
    objdir = os.path.abspath(args.objdir)

    compile_commands: list[dict[str, str]] = []
    for module in modules:
        command = ([args.cxx] + cppflags + cxxflags
                   + ['-c', module['source'], '-o', module['obj']])
        compile_commands.append({
            'directory': objdir,
            'file': module['source'],
            'output': module['obj'],
            'command': ' '.join(shlex.quote(part) for part in command),
        })
    database = os.path.join(objdir, 'compile_commands.json')
    with open(database, 'w', encoding='utf8') as fh:
        json.dump(compile_commands, fh, indent=2)
        fh.write('\n')

    deps_file = os.path.join(objdir, 'module_deps.json')
    command = [scan_deps, '-format=p1689', '-compilation-database=' + database, '-o', deps_file]
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0:
        sys.stderr.write(result.stdout)
        sys.stderr.write(result.stderr)
        fatal("C++ module scan failed")
    if not os.path.exists(deps_file):
        fatal("C++ module scan produced no dependency file")

    with open(deps_file, 'r', encoding='utf8') as fh:
        data = json.load(fh)
    rules: dict[str, dict[str, Any]] = {}
    for rule in data.get('rules', []):
        output = os.path.basename(rule.get('primary-output', ''))
        rules[output] = rule

    for module in modules:
        rule = rules.get(module['obj'])
        if rule is None:
            fatal("C++ module scan produced no rule for '" + module['source'] + "'")
        module['provides'] = [provide['logical-name']
                              for provide in rule.get('provides', [])
                              if provide.get('is-interface', False)]
        module['requires'] = [require['logical-name']
                              for require in rule.get('requires', [])]


def resolve_modules(args: argparse.Namespace, modules: list[dict[str, Any]],
                    external: set[str], headers: dict[str, dict[str, Any]]) -> None:
    providers: dict[str, dict[str, Any]] = {}
    for module in modules:
        for name in module['provides']:
            if name in providers:
                fatal("Duplicate C++ module provider '" + name + "' in '"
                      + providers[name]['source'] + "' and '" + module['source'] + "'")
            providers[name] = module

    for module in modules:
        direct: list[dict[str, Any]] = []
        header_deps: list[dict[str, Any]] = []
        for name in module['requires']:
            if name in providers:
                if providers[name] not in direct:
                    direct.append(providers[name])
            elif name in external:
                continue
            elif '/' in name or '\\' in name:
                if args.backend != 'gcc':
                    continue
                header = headers.get(os.path.abspath(name))
                if header is not None and header not in header_deps:
                    header_deps.append(header)
            elif name == 'std':
                if args.backend == 'gcc':
                    if not os.path.exists(os.path.join(args.objdir, 'gcm.cache', 'std.gcm')):
                        fatal("C++ module 'std' is required, but gcm.cache/std.gcm was not found; "
                              "precompile the std module before building")
                else:
                    fatal("C++ module 'std' is required, but no -fmodule-file=std=<path>.pcm was "
                          "provided; precompile the std module and pass "
                          "-fmodule-file=std=<path>")
            else:
                fatal("C++ module '" + name + "' required by '" + module['source']
                      + "' has no provider; precompile it and pass -fmodule-file=" + name
                      + "=<path>")
        module['direct_deps'] = direct
        module['header_deps'] = header_deps

    for module in modules:
        if args.backend == 'clang':
            deps: list[dict[str, Any]] = []
            seen: set[str] = set()
            stack: list[dict[str, Any]] = list(module['direct_deps'])
            while stack:
                dep = stack.pop()
                if dep['obj'] in seen:
                    continue
                seen.add(dep['obj'])
                deps.append(dep)
                stack.extend(dep['direct_deps'])
            module['deps'] = sorted(deps, key=lambda entry: entry['obj'])


def clang_module_flags(module: dict[str, Any], include_self: bool) -> list[str]:
    deps: list[dict[str, Any]] = list(module['deps'])
    if include_self:
        deps.append(module)
    flags: list[str] = []
    for dep in sorted(deps, key=lambda entry: entry['obj']):
        pcm = dep['stem'] + '.pcm'
        for name in sorted(dep['provides']):
            flags.append('-fmodule-file=' + name + '=' + pcm)
    return flags


def gcc_module_target(module: dict[str, Any], module_only: bool) -> str:
    if module_only and module['provides']:
        return os.path.join('gcm.cache', module['provides'][0] + '.gcm')
    return module['obj']


def generate_gcc(modules: list[dict[str, Any]], headers: dict[str, dict[str, Any]],
                 module_only: bool) -> str:
    lines: list[str] = []
    module_objs = sorted({module['obj'] for module in modules
                          if module['provides'] and not module_only})
    module_cmis = sorted({header['cmi'] for header in headers.values()})
    if module_only:
        module_cmis = sorted(set(module_cmis)
                             | {gcc_module_target(module, module_only) for module in modules
                                if module['provides']})
    lines.append('VK_MODULE_FLAGS = $(filter-out -fmodule-header% -fmodule-only,'
                 '$(CXXFLAGS) $(CPPFLAGS))')
    lines.append('VK_MODULE_OBJS = ' + ' '.join(module_objs))
    lines.append('VK_MODULE_CMIS = ' + ' '.join(module_cmis))
    lines.append('')
    lines.append('.PHONY: modules')
    lines.append('modules: $(VK_MODULE_OBJS) $(VK_MODULE_CMIS)')
    lines.append('')
    for header in sorted(headers.values(), key=lambda entry: entry['cmi']):
        deps = ' '.join(['$(VM_PREFIX).mk'] + [dep['cmi'] for dep in header['deps']])
        lines.append(header['cmi'] + ': ' + header['path'] + ' ' + deps)
        lines.append('\t$(OBJCACHE) $(CXX) $(OPT_FAST) $(VK_MODULE_FLAGS) -fmodule-header'
                     ' -x c++-header ' + header['path'])
        lines.append('')
    for module in sorted(modules, key=lambda entry: entry['obj']):
        deps = ['$(VM_PREFIX).mk']
        deps.extend(gcc_module_target(dep, module_only) for dep in module['direct_deps'])
        deps.extend(header['cmi'] for header in module['header_deps'])
        prereqs = module['source'] + ' ' + ' '.join(sorted(set(deps)))
        if module_only and module['provides']:
            lines.append(gcc_module_target(module, module_only) + ': ' + prereqs)
            lines.append('\t$(OBJCACHE) $(CXX) $(OPT_FAST) $(VK_MODULE_FLAGS) -fmodule-only -c '
                         + module['source'])
        else:
            lines.append(module['obj'] + ': ' + prereqs)
            lines.append('\t$(OBJCACHE) $(CXX) $(OPT_FAST) $(VK_MODULE_FLAGS) -c '
                         + module['source'] + ' -o ' + module['obj'])
        lines.append('')
    return '\n'.join(lines)


def generate_clang(modules: list[dict[str, Any]]) -> str:
    lines: list[str] = []
    module_objs = sorted(module['obj'] for module in modules)
    lines.append('VK_MODULE_OBJS = ' + ' '.join(module_objs))
    lines.append('')
    lines.append('.PHONY: modules')
    lines.append('modules: $(VK_MODULE_OBJS)')
    lines.append('')
    for module in sorted(modules, key=lambda entry: entry['obj']):
        source = module['source']
        obj = module['obj']
        dep_pcms = sorted({dep['stem'] + '.pcm' for dep in module['deps']})
        prereqs = [source, '$(VM_PREFIX).mk'] + dep_pcms
        recipe = ['$(OBJCACHE)', '$(CXX)', '$(OPT_FAST)', '$(CXXFLAGS)', '$(CPPFLAGS)']
        if module['provides']:
            pcm = module['stem'] + '.pcm'
            lines.append(pcm + ': ' + ' '.join(prereqs))
            lines.append('\t' + ' '.join(recipe + clang_module_flags(module, False)
                                          + ['--precompile', source, '-o', pcm]))
            lines.append('')
            prereqs = [pcm] + prereqs
        lines.append(obj + ': ' + ' '.join(prereqs))
        lines.append('\t' + ' '.join(recipe + clang_module_flags(module, bool(module['provides']))
                                      + ['-c', source, '-o', obj]))
        lines.append('')
    return '\n'.join(lines)


def scan(args: argparse.Namespace) -> None:
    if args.backend not in ('gcc', 'clang'):
        fatal("Unsupported C++ module dependency backend '" + args.backend + "'")

    cppflags = parse_flags(args.cppflags)
    cxxflags = parse_flags(args.cxxflags)
    external = external_modules(cppflags + cxxflags)
    module_only = False
    headers: dict[str, dict[str, Any]] = {}
    if args.backend == 'gcc':
        module_only = any(flag == '-fmodule-only' for flag in cppflags + cxxflags)
        cppflags = [flag for flag in cppflags if not is_module_control_flag(flag)]
        cxxflags = [flag for flag in cxxflags if not is_module_control_flag(flag)]

    if args.objdir:
        os.makedirs(args.objdir, exist_ok=True)

    modules = collect_sources(args)
    if args.backend == 'gcc':
        headers = prepare_gcc_headers(args, cppflags, cxxflags, modules)
        scan_gcc(args, cppflags, cxxflags, modules)
    else:
        scan_clang(args, cppflags, cxxflags, modules)
    resolve_modules(args, modules, external, headers)

    if args.backend == 'gcc':
        content = generate_gcc(modules, headers, module_only)
    else:
        content = generate_clang(modules)

    old_content = None
    if os.path.exists(args.output):
        with open(args.output, 'r', encoding='utf8') as fh:
            old_content = fh.read()
    if content != old_content:
        with open(args.output, 'w', encoding='utf8') as fh:
            fh.write(content)


def main() -> None:
    parser = argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument('--backend', required=True, help='dependency backend')
    parser.add_argument('--cxx', required=True, help='C++ compiler')
    parser.add_argument('--cxxflags', default='', help='C++ compiler flags')
    parser.add_argument('--cppflags', default='', help='C preprocessor flags')
    parser.add_argument('--objdir', default='.', help='object directory')
    parser.add_argument('--output', required=True, help='output make fragment')
    parser.add_argument('--source', action='append', default=[], help='C++ source file')
    args = parser.parse_args(normalize_args(sys.argv[1:]))
    scan(args)


if __name__ == '__main__':
    main()

######################################################################
